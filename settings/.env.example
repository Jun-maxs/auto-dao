# MinerU API Key (用于文档转换)
MINERU_API_KEY=your_api_key

# ============================================================
# Notion Integration Token (用于 Notion MCP, stdio 模式 = 零弹窗)
# ============================================================
# 创建步骤:
#   1. 访问 https://www.notion.so/profile/integrations
#   2. 点击 "New integration" -> Type 选 "Internal"
#   3. 关联 workspace, 点 Save -> 复制 "Internal Integration Secret" (ntn_... 开头)
#   4. 在你想给 MCP 访问的 Notion 页面右上角 "..." 菜单 -> "Connect to" -> 选刚建的 integration
#
# 注意: .mcp.json 通过 ${NOTION_TOKEN} 读取此变量,
#   该变量必须在 *系统/Shell 环境变量* 中设置 (settings/.env 不会被自动加载)。
#
# Windows PowerShell 永久设置 (推荐, 重启终端生效):
#   [Environment]::SetEnvironmentVariable("NOTION_TOKEN", "ntn_xxx", "User")
#
# Windows PowerShell 当前会话临时:
#   $env:NOTION_TOKEN = "ntn_xxx"
#
# macOS / Linux (添加到 ~/.zshrc 或 ~/.bashrc):
#   export NOTION_TOKEN="ntn_xxx"
NOTION_TOKEN=ntn_your_notion_integration_token
